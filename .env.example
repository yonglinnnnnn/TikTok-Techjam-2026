# --- Tier 2: VLM providers (Member 3) ---
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Tier 1: Provenance / watermark checks (Member 2) ---
# OpenAI content-provenance check uses OPENAI_API_KEY above.
META_STABLE_SIGNATURE_ENDPOINT=

# --- General ---
# "development" | "evaluation" -- selects configs/{name}.yaml
TRUESIGHT_ENV=development

# Cap on concurrent VLM/API calls (router.py uses this to avoid rate limits)
MAX_CONCURRENT_API_CALLS=4
